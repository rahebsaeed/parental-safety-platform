# Parental Safety Platform — environment configuration
# Copy to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Phase 1 & 2 — Collector
# ---------------------------------------------------------------------------
# Override auto-detected interface/subnet if detection picks the wrong one.
# Leave blank to auto-detect from `ip route show`.
DISCOVERY_INTERFACE=
DISCOVERY_SUBNET=

# Where the Phase 1 SQLite store lives.
# Used by the collector. The backend reads from the same path via DATABASE_PATH.
# Dev default (run with cwd=collector/): ./data/discovery.sqlite3
# Production (/opt install, set automatically by install.sh):
#   DISCOVERY_DB_PATH=/opt/parental-safety/collector/data/discovery.sqlite3
DISCOVERY_DB_PATH=./data/discovery.sqlite3

# dnsmasq log watched by the collector ingester.
# Collector reads DNS_LOG_PATH; backend health checks read DNSMASQ_LOG_PATH.
# Keep both pointing at the same file in production.
DNS_LOG_PATH=/var/log/parental-safety/dnsmasq.log

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Phase 3+ — Backend API
# ---------------------------------------------------------------------------
# Absolute path to the SQLite database file (read by the FastAPI backend).
# Leave blank to use the auto-discovery logic in config.py.
DATABASE_PATH=

# For PostgreSQL instead of SQLite (optional):
# DATABASE_URL=postgresql://user:password@localhost:5432/parental_safety

# CORS: comma-separated list of allowed origins for the API.
# In production set this to your LAN address only.
# CORS_ORIGINS=["http://192.168.1.20"]

# ---------------------------------------------------------------------------
# Phase 10 — Security & Authentication
# ---------------------------------------------------------------------------
# Password required to access the parent dashboard.
# IMPORTANT: Change this before running in production.
# A random password is generated automatically by install.sh.
PARENT_PASSWORD=admin123

# Set to false to disable authentication entirely (development only).
AUTH_ENABLED=true

# Sliding-window rate limiting on the API (requests per minute per IP).
RATE_LIMIT_ENABLED=true

# How long a parent session token is valid for (hours).
SESSION_EXPIRE_HOURS=24

# ---------------------------------------------------------------------------
# Phase 11 — Deployment
# ---------------------------------------------------------------------------
# Paths used by systemd services (overridable for custom install locations).
# DNSMASQ_LOG_PATH=/var/log/parental-safety/dnsmasq.log
# PID_FILE=/run/parental-safety-dnsmasq.pid
