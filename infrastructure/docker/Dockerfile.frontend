# syntax=docker/dockerfile:1
# =============================================================================
# Dockerfile.frontend — React dashboard via nginx
# =============================================================================
# Multi-stage: Node builder → nginx-alpine serving dist/ with API proxy
# Build context: project root  (docker build -f infrastructure/docker/Dockerfile.frontend .)
# =============================================================================

# ---- Stage 1: Build the React app ----------------------------------------
FROM node:20-alpine AS builder

WORKDIR /build

# Dependency install (cached layer)
COPY frontend/package*.json ./
RUN npm ci --prefer-offline

# Build
COPY frontend/ ./
RUN npm run build
# Output is in /build/dist

# ---- Stage 2: Serve with nginx -------------------------------------------
FROM nginx:1.27-alpine AS runtime

# Remove default nginx site
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy our custom nginx config
COPY infrastructure/docker/nginx-frontend.conf /etc/nginx/conf.d/parental-monitor.conf

# Copy built React app
COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost/api/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
