[Unit]
Description=Parental Safety Platform — Hourly AI Domain Classification Sync
Documentation=https://github.com/local/parental-safety-platform
# New domains land in dns_queries around the clock; without this, they sit
# UNCATEGORIZED (invisible to alerts) until someone presses Sync by hand.
# Each run classifies static rules first, then sends at most ai_limit
# unknowns to the AI model and persists verdicts as rules. Cache-first and
# bounded, so steady-state runs are local-DB-only no-ops.
After=network-online.target parental-monitor-api.service
Wants=network-online.target parental-monitor-api.service

[Service]
Type=oneshot
User=parental-monitor
Group=parental-monitor

# A full 20-domain pass with model failover can take minutes on free pools.
TimeoutStartSec=15min

ExecStart=/usr/bin/curl -fsS --max-time 840 -X POST \
    "http://127.0.0.1:8000/api/classifications/sync?ai_limit=20"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=parental-monitor-ai-sync

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=no

[Install]
WantedBy=multi-user.target
